<%- include('../../components/head') %>
<%- include('../../components/navbar') %>
<%- include('../../components/bg-decorations') %>

<div class="auth-wrapper">
  <div class="auth-card">
    <h1 class="auth-title">Login</h1>
    <p class="auth-subtitle">Entre em sua conta agora mesmo.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger py-2 mb-3" style="font-size: 0.88rem; border-radius: 0.6rem; background: rgba(220, 53, 69, 0.2); border-color: rgba(220, 53, 69, 0.4); color: #ff8591;">
        <%= error %>
      </div>
    <% } %>

    <form action="/auth/login" method="POST" id="form-login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label for="login-email" class="form-label">Seu Email</label>
        <input id="login-email" type="email" class="form-control" name="email" placeholder="dev@exemplo.com" required>
      </div>

      <div class="mb-4">
        <label for="login-password" class="form-label">Sua senha</label>
        <input id="login-password" type="password" class="form-control" name="password" placeholder="••••••••" required>
      </div>

      <button id="btn-login-submit" type="submit" class="btn-grad w-100 py-2">Faça login</button>
    </form>

    <div class="text-center mt-4">
      <a href="/auth/register" class="auth-footer-link">Não tem uma conta? Faça seu cadastro</a>
    </div>
  </div>
</div>

<%- include('../../components/footer') %>