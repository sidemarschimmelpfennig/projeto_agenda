<%- include('../../components/head') %>
<%- include('../../components/navbar') %>
<%- include('../../components/bg-decorations') %>

<div class="auth-wrapper">
  <div class="auth-card">
    <h1 class="auth-title">Cadastre-se</h1>
    <p class="auth-subtitle">Crie sua conta preenchendo os campos abaixo.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger py-2 mb-3" style="font-size: 0.88rem; border-radius: 0.6rem; background: rgba(220, 53, 69, 0.2); border-color: rgba(220, 53, 69, 0.4); color: #ff8591;">
        <%= error %>
      </div>
    <% } %>

    <form action="/auth/register" method="POST" id="form-register">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label for="register-name" class="form-label">Seu Nome</label>
        <input id="register-name" type="text" class="form-control" name="name" placeholder="Seu nome completo" required>
      </div>

      <div class="mb-3">
        <label for="register-email" class="form-label">Seu Email</label>
        <input id="register-email" type="email" class="form-control" name="email" placeholder="dev@exemplo.com" required>
      </div>

      <div class="mb-4">
        <label for="register-password" class="form-label">Sua senha</label>
        <input id="register-password" type="password" class="form-control" name="password" placeholder="Mínimo 6 caracteres" required>
      </div>

      <button id="btn-register-submit" type="submit" class="btn-grad w-100 py-2">Criar minha conta</button>
    </form>

    <div class="text-center mt-4">
      <a href="/auth/login" class="auth-footer-link">Já possui uma conta? Faça login</a>
    </div>
  </div>
</div>

<%- include('../../components/footer') %>