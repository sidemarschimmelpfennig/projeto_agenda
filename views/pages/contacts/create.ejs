<%- include('../../components/head') %>
<%- include('../../components/nav') %>

<div class="container">
  <div class="row">
    <div class="col-lg-2"></div>
    
    <div class="col-lg-8 my-3">
      <h1 class="text-center">Contato</h1>
      <p class="text-center lead">Crie ou edite seu contato abaixo.</p>

      <%- include('../../components/messages') %>


      <% if(contact.id) { %>
        <form action="/contact/edit/<%= contact.id %>" method="POST">
        <% } else { %>
        <form action="/contact/register" method="POST">
        <% } %>
        <input type="hidden" name="_csrf" value=<%= csrfToken %>>
        <div class="mb-3">
          <label class="form-label">Nome</label>
          <input value="<%= contact.name %>" type="text" class="form-control" name="name">
        </div>
        <div class="mb-3">
          <label class="form-label">Sobrenome</label>
          <input value="<%= contact.last_name %>" type="text" class="form-control" name="last_name">
        </div>
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input value="<%= contact.email %>" type="email" class="form-control" name="email">
        </div>
        <div class="mb-3">
          <label class="form-label">Telefone</label>
          <input value="<%= contact.phone %>" type="tel" class="form-control" name="phone">
        </div>
        <button type="submit" class="btn btn-dark">Salvar</button>
      </form>


    </div>

    <div class="col-lg-2"></div>
  </div>
</div>

<%- include('../../components/footer') %>