<%- include('../../components/head') %>
<%- include('../../components/navbar') %>
<%- include('../../components/bg-decorations') %>

<div class="auth-wrapper">
  <div class="auth-card" style="max-width: 520px;">
    <h1 class="auth-title">Editar Contato</h1>
    <p class="auth-subtitle">Atualize as informações do contato abaixo.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger py-2 mb-3" style="font-size: 0.88rem; border-radius: 0.6rem; background: rgba(220, 53, 69, 0.2); border-color: rgba(220, 53, 69, 0.4); color: #ff8591;">
        <%= error %>
      </div>
    <% } %>

    <form action="/contacts/edit/<%= contact.id %>" method="POST" id="form-edit-contact">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label" for="contact-name">Nome *</label>
          <input type="text" class="form-control" id="contact-name" name="name" value="<%= contact.name %>" required>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label" for="contact-lastname">Sobrenome</label>
          <input type="text" class="form-control" id="contact-lastname" name="lastName" value="<%= contact.lastName || contact.last_name || '' %>">
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="contact-email">Email</label>
        <input type="email" class="form-control" id="contact-email" name="email" value="<%= contact.email || '' %>">
      </div>

      <div class="mb-4">
        <label class="form-label" for="contact-phone">Telefone</label>
        <input type="tel" class="form-control" id="contact-phone" name="phone" value="<%= contact.phone || '' %>">
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn-grad flex-grow-1 py-2">Salvar Alterações</button>
        <a href="/contacts" class="btn-ghost py-2 px-3 text-center">Voltar</a>
      </div>
    </form>
  </div>
</div>

<%- include('../../components/footer') %>