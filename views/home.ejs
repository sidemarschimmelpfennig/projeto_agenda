<%- include('components/head') %>
<%- include('components/navbar') %>
<%- include('components/bg-decorations') %>

<!-- Hero -->
<main class="hero">
  <img src="/images/hero-illustration.svg" alt="Agenda com lupa" class="hero-illustration">

  <h1>AGENDA DO DEV</h1>
  <p class="subtitle">Inicie em sua agenda de gestão agora mesmo</p>
  <p class="desc">O buscador de compromissos e tarefas ideal para desenvolvedores.</p>

  <form class="search-bar" action="/contacts" method="GET" role="search">
    <input id="home-search" type="search" name="q" placeholder="Buscar compromissos, tarefas ou eventos..." aria-label="Buscar">
    <button id="home-search-btn" type="submit" class="btn-grad">Buscar</button>
  </form>

  <div class="cta">
    <a id="cta-start" class="btn-grad" href="/auth/register">Iniciar Grátis</a>
    <a id="cta-more" class="btn-ghost" href="#">Saber Mais</a>
  </div>
</main>

<%- include('components/footer') %>